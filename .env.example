# Public canonical URL used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://africanrobotplatform.org

# --- Database (PostgreSQL) --------------------------------------------------
# Local: a Postgres you run yourself, e.g.
#   docker run -d --name arcp-pg -e POSTGRES_PASSWORD=arcp -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:arcp@localhost:5432/postgres
# On Vercel: attach the "Postgres" storage to the project and it injects
# POSTGRES_URL / POSTGRES_URL_NON_POOLING automatically — leave DATABASE_URL unset.

# --- Media uploads -----------------------------------------------------------
# On Vercel: attach the "Blob" storage to the project (injects
# BLOB_READ_WRITE_TOKEN automatically). Required for uploading images/PDFs
# from the admin — without it, the upload button in /admin will fail.
BLOB_READ_WRITE_TOKEN=

# --- Admin (/admin) ----------------------------------------------------------
# Signs the admin session cookie. 32+ random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Used once, by `npm run db:seed`, to create the single owner account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Exact origins allowed to submit public forms. In production, keep only the
# canonical HTTPS origin. Multiple origins are separated by commas.
FORM_ALLOWED_ORIGINS=http://localhost:3000,https://africanrobotplatform.org

# Optional path when publishing below a subdirectory, for example /repository-name.
NEXT_PUBLIC_BASE_PATH=

# Same-origin API routes store requests directly in this app's database.
# Override only if a dedicated form service is used.
NEXT_PUBLIC_MEMBERSHIP_FORM_ENDPOINT=/api/forms/join
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=/api/forms/contact
NEXT_PUBLIC_NEWSLETTER_FORM_ENDPOINT=/api/forms/newsletter
