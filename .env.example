# Public canonical URL used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://africanrobotplatform.org

# Server-only connection to the separate Payload administration service.
# Never prefix these values with NEXT_PUBLIC_.
CMS_URL=http://localhost:3001
CMS_API_TOKEN=copy-the-cms-api-token-from-cms-env

# Exact origins allowed to submit public forms. In production, keep only the
# canonical HTTPS origin. Multiple origins are separated by commas.
FORM_ALLOWED_ORIGINS=http://localhost:3000,https://africanrobotplatform.org

# Optional path when publishing below a subdirectory, for example /repository-name.
NEXT_PUBLIC_BASE_PATH=

# Same-origin API routes store requests in the separate CMS. Override only if
# a dedicated form service is used.
NEXT_PUBLIC_MEMBERSHIP_FORM_ENDPOINT=/api/forms/join
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=/api/forms/contact
NEXT_PUBLIC_NEWSLETTER_FORM_ENDPOINT=/api/forms/newsletter
