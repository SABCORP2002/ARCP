{
  "name": "africa-robotics-association",
  "version": "1.0.0",
  "private": true,
  "description": "Public Next.js website connected to the separate code-based Payload administration for ARCP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "cms:install": "npm --prefix cms ci",
    "cms:dev": "npm --prefix cms run dev",
    "cms:seed": "npm --prefix cms run seed",
    "cms:build": "npm --prefix cms run build",
    "cms:start": "npm --prefix cms run start -- -H 127.0.0.1 -p 3001",
    "push:backoffice": "node scripts/push-backoffice.mjs",
    "deploy:check": "node scripts/deployment-preflight.mjs",
    "deploy:build": "node scripts/deploy.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:cms": "npm --prefix cms run typecheck",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:cms && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "framer-motion": "^12.43.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
