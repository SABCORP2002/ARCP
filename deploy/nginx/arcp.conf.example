# Nginx reverse proxy for the two ARCP Node services (alternative to Caddy).
# Replace every "africanrobotplatform.org" with the real domain, then have the
# host add TLS (certbot / its cert manager) before opening the site publicly.
#   sudo cp deploy/nginx/arcp.conf.example /etc/nginx/sites-available/arcp.conf
#   sudo ln -s /etc/nginx/sites-available/arcp.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name www.africanrobotplatform.org;
    return 301 https://africanrobotplatform.org$request_uri;
}

server {
    listen 80;
    server_name africanrobotplatform.org;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 80;
    server_name admin.africanrobotplatform.org;
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# The host must add TLS certificates or let its certificate manager upgrade
# these virtual hosts to HTTPS before production traffic is enabled.
