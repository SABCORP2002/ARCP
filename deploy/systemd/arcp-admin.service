[Unit]
Description=ARCP administration website
After=network.target

[Service]
Type=simple
User=arcp
Group=arcp
WorkingDirectory=/var/www/arcp/cms
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3001
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/arcp/cms/media /var/www/arcp/cms/.next
UMask=0027

[Install]
WantedBy=multi-user.target
