# HestiaCP — custom Nginx directives for africanrobotplatform.org
#
# Paste these location directives into the domain's custom Nginx template
# (HestiaCP: web domain -> Edit -> Nginx directives / custom template). HestiaCP
# already owns the server block, TLS certificate (Let's Encrypt) and port 80/443
# listeners; these lines only forward requests to the Next.js public site.
#
# Expected: the public site listens on 127.0.0.1:3000 (systemd unit
# arcp-public.service). Nothing else should be proxied from this domain.

location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 60s;
}
